PORT=5000
NODE_ENV=development

# PostgreSQL Connection String for Prisma ORM
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/collections_by_chandni"

# JWT Authentication Configuration
JWT_SECRET="replace-with-a-secure-secret"
JWT_EXPIRES_IN="1d"

# Cloudinary Image Storage Configuration (Step 8)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PayU Hosted Checkout & Payment Gateway Configuration (Step 21)
PAYU_KEY=
PAYU_SALT=
PAYU_ENV=test
PAYU_VERIFY_URL=https://test.payu.in/merchant/postservice.php?form=2
FRONTEND_URL=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:3000

# Shiprocket Shipping & Logistics Configuration (Step 22)
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_ENV=test
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_WEBHOOK_SECRET=
SHIPROCKET_DEFAULT_WEIGHT_KG=0.5
SHIPROCKET_DEFAULT_LENGTH_CM=15
SHIPROCKET_DEFAULT_BREADTH_CM=10
SHIPROCKET_DEFAULT_HEIGHT_CM=5

# Step 26: Email & WhatsApp Order Confirmations Configuration
# Email Provider: 'RESEND', 'SMTP', or 'DRY_RUN'
EMAIL_PROVIDER=DRY_RUN
EMAIL_FROM="Collections by Chandni <orders@collectionsbychandni.in>"

# Resend API (if using EMAIL_PROVIDER=RESEND)
RESEND_API_KEY=

# SMTP Configuration (if using EMAIL_PROVIDER=SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# WhatsApp Configuration via MSG91 Official API
MSG91_AUTH_KEY=
MSG91_INTEGRATED_NUMBER=917755887517
MSG91_WHATSAPP_URL=https://control.msg91.com/api/v5/whatsapp/whatsapp-outbound-message/bulk/

# Approved MSG91 WhatsApp Template Identifiers
MSG91_TEMPLATE_ORDER_CONFIRMATION=cbc_order_confirmation
MSG91_TEMPLATE_PAYMENT_CONFIRMATION=cbc_payment_confirmation
MSG91_TEMPLATE_ORDER_DISPATCHED=cbc_order_dispatched
MSG91_TEMPLATE_ORDER_CANCELLED=cbc_order_cancelled
MSG91_TEMPLATE_REFUND_PROCESSED=cbc_refund_processed
